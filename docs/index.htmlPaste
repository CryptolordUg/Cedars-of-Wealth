<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cedars of Wealth</title>
<style>
body{font-family:system-ui;background:#0f172a;color:#e2e8f0;margin:0;padding:20px}
.card{background:#1e293b;padding:20px;border-radius:12px;margin:10px 0}
h1{color:#fbbf24}
.green{color:#22c55e}.red{color:#ef4444}
button{background:#fbbf24;border:0;padding:10px 20px;border-radius:8px;font-weight:bold}
</style>
</head>
<body>
<h1>🌲 Cedars of Wealth</h1>
<p>Demo Dashboard - Live on GitHub Pages</p>

<div class="card">
<h3>Portfolio Balance</h3>
<h2>$12,450.75 <span class="green">+5.2%</span></h2>
</div>

<div class="card">
<h3>API Status</h3>
<p id="status">Checking backend...</p>
<button onclick="checkHealth()">Check VPS Health</button>
</div>

<div class="card">
<h3>Recent Trades (Demo)</h3>
<p class="green">+ BTC/USDT LONG +$245</p>
<p class="red">- ETH/USDT SHORT -$32</p>
<p class="green">+ SOL/USDT LONG +$112</p>
</div>

<script>
async function checkHealth(){
  const vps = prompt("Enter your VPS IP (or cancel for demo):");
  if(!vps) {document.getElementById('status').innerText="Demo mode - VPS not connected yet"; return;}
  try{
    const r = await fetch(`http://${vps}:8080/v2/gateway/health`);
    const j = await r.json();
    document.getElementById('status').innerText = "Connected: "+JSON.stringify(j);
  }catch(e){document.getElementById('status').innerText="Offline - VPS not reachable yet";}
}
</script>
</body>
</html>
